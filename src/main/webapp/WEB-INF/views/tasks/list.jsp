<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/>
<!DOCTYPE html><html lang="${currentLanguage}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><fmt:message key="task.title"/> | JAPAN LIFE GUIDE</title><c:url var="css" value="/css/app.css"/><link rel="stylesheet" href="${css}"></head><body><%@ include file="../fragments/header.jspf" %>
<main id="main" class="page-shell">
  <section class="page-intro"><p class="eyebrow"><fmt:message key="task.calendarEyebrow"/></p><h1><fmt:message key="task.title"/></h1><p class="muted"><fmt:message key="task.intro"/></p></section>
  <section class="calendar-layout" aria-label="<fmt:message key='task.calendarEyebrow'/>">
    <section class="calendar-panel" aria-labelledby="calendar-title">
      <div class="calendar-heading"><c:url var="previousMonthUrl" value="/my/tasks"><c:param name="date" value="${previousMonth}-01"/></c:url><a class="calendar-nav" href="${previousMonthUrl}" aria-label="<fmt:message key='task.previousMonth'/>">←</a><h2 id="calendar-title">${monthLabel}</h2><c:url var="nextMonthUrl" value="/my/tasks"><c:param name="date" value="${nextMonth}-01"/></c:url><a class="calendar-nav" href="${nextMonthUrl}" aria-label="<fmt:message key='task.nextMonth'/>">→</a></div>
      <div class="calendar-weekdays"><span><fmt:message key="task.sun"/></span><span><fmt:message key="task.mon"/></span><span><fmt:message key="task.tue"/></span><span><fmt:message key="task.wed"/></span><span><fmt:message key="task.thu"/></span><span><fmt:message key="task.fri"/></span><span><fmt:message key="task.sat"/></span></div>
      <div class="calendar-grid"><c:forEach items="${calendarDays}" var="day"><c:url var="dayUrl" value="/my/tasks"><c:param name="date" value="${day.date}"/></c:url><div class="calendar-cell"><a class="calendar-day ${day.today ? 'today' : ''} ${day.selected ? 'selected' : ''} ${day.eventCount > 0 ? 'has-events' : ''} ${day.inMonth ? '' : 'outside'}" href="${dayUrl}" data-calendar-date="${day.date}" ${day.inMonth ? '' : 'aria-hidden="true"'}><span>${day.day}</span><c:if test="${day.eventCount > 0}"><small>${day.eventCount}</small></c:if></a><c:if test="${day.eventCount > 0}"><div class="calendar-popover" role="status"><strong>${day.date}</strong><c:forEach items="${eventsByDate[day.date]}" var="event"><div class="popover-event ${event.completed == 'Y' ? 'is-completed' : ''}"><span>${event.completed == 'Y' ? '✓' : '○'}</span><span><b><c:out value="${event.title}"/></b><small><c:out value="${event.taskTitle}"/></small></span><form action="<c:url value='/my/events/${event.id}/toggle'/>" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit" class="popover-action" aria-label="<fmt:message key='task.toggleEvent'/>">${event.completed == 'Y' ? '↶' : '✓'}</button></form><form action="<c:url value='/my/events/${event.id}/delete'/>" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit" class="popover-action delete" aria-label="<fmt:message key='task.deleteEvent'/>">×</button></form></div></c:forEach></div></c:if></div></c:forEach></div>
      <p class="calendar-note"><fmt:message key="task.calendarNote"/></p>
    </section>
    <section class="event-form content-panel" aria-labelledby="add-event-title"><h2 id="add-event-title"><fmt:message key="task.addEvent"/></h2><p class="muted event-form-help"><fmt:message key="task.eventFormHelp"/></p><form action="<c:url value='/my/events'/>" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label for="event-date"><fmt:message key="task.eventDate"/></label><input id="event-date" name="eventDate" type="date" value="${selectedDate}" required><label for="event-task"><fmt:message key="task.eventProcedure"/></label><select id="event-task" name="taskId" required><option value=""><fmt:message key="task.chooseProcedure"/></option><c:forEach items="${tasks}" var="task"><option value="${task.id}"><c:out value="${task.savedTitle}"/></option></c:forEach></select><label for="event-title"><fmt:message key="task.eventTitle"/></label><input id="event-title" name="title" maxlength="200" required><label for="event-memo"><fmt:message key="task.eventMemo"/></label><textarea id="event-memo" name="memo" maxlength="1000" rows="3"></textarea><button class="button" type="submit"><fmt:message key="task.addEventButton"/></button></form></section>
  </section>
  <section class="task-section"><h2><fmt:message key="task.savedSection"/></h2><c:if test="${param.deleted ne null}"><p class="form-success"><fmt:message key="task.deleted"/></p></c:if><c:choose><c:when test="${empty tasks}"><div class="empty-state"><h2><fmt:message key="task.emptyTitle"/></h2><p><fmt:message key="task.emptyText"/></p><a class="button" href="<c:url value='/procedures'/>"><fmt:message key="task.find"/></a></div></c:when><c:otherwise><div class="task-grid"><c:forEach items="${tasks}" var="task"><article class="task-card"><span class="category"><c:choose><c:when test="${task.status == 'NOT_STARTED'}"><fmt:message key="task.status.notStarted"/></c:when><c:when test="${task.status == 'PREPARING'}"><fmt:message key="task.status.preparing"/></c:when><c:otherwise><fmt:message key="task.status.completed"/></c:otherwise></c:choose></span><h2><a href="<c:url value='/my/tasks/${task.id}'/>"><c:out value="${task.savedTitle}"/></a></h2><p class="muted"><c:choose><c:when test="${task.currentRevision > task.savedRevision}"><fmt:message key="task.updatedGuide"/></c:when><c:otherwise><fmt:message key="task.latestGuide"/></c:otherwise></c:choose></p><div class="task-card-actions"><a class="text-link" href="<c:url value='/my/tasks/${task.id}'/>"><fmt:message key="task.view"/> ↗</a><form action="<c:url value='/my/tasks/${task.id}/delete'/>" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit" class="text-link task-delete" data-confirm="<fmt:message key='task.deleteConfirm'/>"><fmt:message key="task.delete"/></button></form></div></article></c:forEach></div></c:otherwise></c:choose></section>
</main><%@ include file="../fragments/footer.jspf" %></body></html>
