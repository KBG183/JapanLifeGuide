<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/>
<!DOCTYPE html><html lang="${currentLanguage}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${task.savedTitle}"/> | JAPAN LIFE GUIDE</title><c:url var="css" value="/css/app.css"/><link rel="stylesheet" href="${css}"></head><body><%@ include file="../fragments/header.jspf" %><main id="main" class="page-shell detail-shell"><p class="eyebrow"><fmt:message key="task.checklistEyebrow"/></p><h1><c:out value="${task.savedTitle}"/></h1><p class="muted"><c:choose><c:when test="${task.currentRevision > task.savedRevision}"><fmt:message key="task.updatedGuide"/></c:when><c:otherwise><fmt:message key="task.latestGuide"/></c:otherwise></c:choose></p><section class="content-panel"><h2><fmt:message key="task.documents"/></h2><form action="<c:url value='/my/tasks/${task.id}/checks'/>" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><ul class="document-list"><c:forEach items="${task.checks}" var="check"><li class="check-row"><label><input class="check-input" type="checkbox" name="checkedIds" value="${check.id}" ${check.checked == 'Y' ? 'checked' : ''} aria-label="<fmt:message key='task.checkAria'/>"><span class="check-mark" aria-hidden="true">${check.checked == 'Y' ? '✓' : '○'}</span><span><strong><c:out value="${check.documentName}"/></strong><small><c:out value="${check.conditionText}"/></small></span></label></li></c:forEach></ul><div class="check-save"><button class="button" type="submit"><fmt:message key="task.saveChecks"/></button></div></form></section><div class="task-detail-actions"><a class="text-link" href="<c:url value='/my/tasks'/>">← <fmt:message key="task.back"/></a><form class="task-delete-form" action="<c:url value='/my/tasks/${task.id}/delete'/>" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit" class="text-link task-delete" data-confirm="<fmt:message key='task.deleteConfirm'/>"><fmt:message key="task.delete"/></button></form></div></main><%@ include file="../fragments/footer.jspf" %></body></html>
