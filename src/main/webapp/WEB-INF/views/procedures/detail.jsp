<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/>
<!DOCTYPE html><html lang="${currentLanguage}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${procedure.title}"/> | JAPAN LIFE GUIDE</title><c:url var="css" value="/css/app.css"/><link rel="stylesheet" href="${css}"></head><body><%@ include file="../fragments/header.jspf" %>
<main id="main" class="page-shell detail-shell">
  <nav class="breadcrumb" aria-label="<fmt:message key='detail.breadcrumbAria'/>"><a href="<c:url value='/procedures'/>"><fmt:message key="detail.breadcrumb"/></a><span aria-hidden="true">/</span><span><fmt:message key="detail.registration"/></span></nav>
  <header class="detail-heading"><div><c:set var="regionKey" value="procedure.region.${procedure.regionId}"/><c:set var="categoryKey" value="procedure.category.${procedure.categoryId}"/><span class="category"><fmt:message key="${regionKey}"/> · <fmt:message key="${categoryKey}"/></span><h1><c:out value="${procedure.title}"/></h1><p><c:out value="${procedure.summary}"/></p></div><div><button type="button" class="button secondary print-button" id="print-page"><fmt:message key="detail.print"/></button><c:if test="${not empty pageContext.request.userPrincipal}"><form action="<c:url value='/my/tasks'/>" method="post" class="save-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="procedureId" value="${procedure.id}"><button type="submit" class="button"><fmt:message key="detail.save"/></button></form></c:if></div></header>
  <div class="detail-grid"><div class="detail-main">
    <section class="content-panel"><p class="eyebrow"><fmt:message key="detail.sectionEligibility"/></p><h2><fmt:message key="detail.eligibility"/></h2><p><c:out value="${procedure.eligibility}"/></p><div class="notice-box"><c:out value="${procedure.notice}"/></div></section>
    <section class="content-panel"><p class="eyebrow"><fmt:message key="detail.sectionDocuments"/></p><h2><fmt:message key="detail.documents"/></h2><p class="muted"><fmt:message key="detail.documentHint"/></p><ul class="document-list"><c:forEach items="${documents}" var="doc"><li><div class="document-title"><h3><c:out value="${doc.name}"/></h3><span class="requirement ${doc.requirement == 'REQUIRED' ? 'required' : 'conditional'}"><c:choose><c:when test="${doc.requirement == 'REQUIRED'}"><fmt:message key="detail.required"/></c:when><c:otherwise><fmt:message key="detail.conditions"/></c:otherwise></c:choose></span></div><p><c:out value="${doc.conditionText}"/></p><c:if test="${not empty doc.description}"><div class="document-guide"><p><strong><fmt:message key="detail.documentAbout"/></strong><br><c:out value="${doc.description}"/></p><p><strong><fmt:message key="detail.documentPreparation"/></strong><br><c:out value="${doc.preparationNote}"/></p><c:set var="documentSourceKey" value="detail.documentSource.${doc.id}"/><fmt:message key="${documentSourceKey}" var="documentSourceUrl"/><c:if test="${not fn:startsWith(documentSourceUrl, '???')}"><p class="document-source"><a href="<c:out value='${documentSourceUrl}'/>" target="_blank" rel="noopener noreferrer"><fmt:message key="detail.documentSourceLabel"/> ↗</a></p></c:if></div></c:if></li></c:forEach></ul><p class="muted small"><fmt:message key="detail.basicNote"/></p></section>
    <section class="content-panel"><p class="eyebrow"><fmt:message key="detail.sectionSteps"/></p><h2><fmt:message key="detail.steps"/></h2><ol class="step-list"><c:forEach items="${steps}" var="step"><li><span class="step-number" aria-hidden="true">${step.stepNo}</span><div><h3><c:out value="${step.title}"/></h3><p><c:out value="${step.description}"/></p></div></li></c:forEach></ol><p class="muted small"><fmt:message key="detail.stepsNote"/></p></section>
    <section class="content-panel" id="sources"><p class="eyebrow"><fmt:message key="detail.sectionSources"/></p><h2><fmt:message key="detail.sources"/></h2><c:forEach items="${sources}" var="source"><c:set var="sourceUrlKey" value="detail.sourceUrl.${source.id}"/><fmt:message key="${sourceUrlKey}" var="localizedSourceUrl"/><c:if test="${fn:startsWith(localizedSourceUrl, '???')}"><c:set var="localizedSourceUrl" value="${source.url}"/></c:if><div class="source-item"><a href="<c:out value='${localizedSourceUrl}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${source.title}"/> ↗</a><p><fmt:message key="detail.reviewDate"/>：<c:out value="${source.checkedOn}"/><c:if test="${not empty source.updatedOn}"> / <fmt:message key="detail.updatedDate"/>：<c:out value="${source.updatedOn}"/></c:if></p></div></c:forEach><p class="muted small"><fmt:message key="detail.sourcesNote"/></p></section>
  </div><aside class="detail-sidebar"><section class="deadline-card"><p class="eyebrow"><fmt:message key="detail.sectionDeadline"/></p><h2><fmt:message key="detail.deadline"/></h2><p><c:out value="${procedure.deadlineText}"/></p><div class="deadline-divider"></div><h3><fmt:message key="detail.method"/></h3><p><c:out value="${procedure.methodText}"/></p></section><section class="office-card"><h2><fmt:message key="detail.office"/></h2><c:forEach items="${offices}" var="office"><h3><c:out value="${office.name}"/></h3><c:if test="${not empty office.address}"><p><c:out value="${office.address}"/></p></c:if><p><c:out value="${office.note}"/></p><a class="text-link" href="<c:out value='${office.homepageUrl}'/>" target="_blank" rel="noopener noreferrer"><fmt:message key="detail.officialOffice"/> ↗</a></c:forEach></section><p class="sidebar-note"><fmt:message key="detail.sidebarNote"/></p></aside></div>
</main><%@ include file="../fragments/footer.jspf" %></body></html>
