<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/><c:set var="adminSection" value="members"/>
<!DOCTYPE html><html lang="${currentLanguage}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><fmt:message key="admin.members"/> | JAPAN LIFE GUIDE</title><c:url var="css" value="/css/app.css"/><link rel="stylesheet" href="${css}"></head><body>
<%@ include file="../fragments/header.jspf" %><main id="main" class="admin-layout"><%@ include file="admin-nav.jspf" %><section class="admin-main">
<header class="admin-page-header"><div><p class="eyebrow"><fmt:message key="admin.eyebrow"/></p><h1><fmt:message key="admin.members"/></h1></div></header>
<c:if test="${param.updated ne null}"><p class="form-success"><fmt:message key="admin.updated"/></p></c:if>
<section class="content-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th><fmt:message key="admin.loginId"/></th><th><fmt:message key="admin.email"/></th><th><fmt:message key="admin.role"/></th><th><fmt:message key="admin.status"/></th><th><fmt:message key="admin.actions"/></th></tr></thead><tbody>
<c:forEach items="${members}" var="m"><tr><td><c:out value="${m.loginId}"/></td><td><c:out value="${m.email}"/></td><td>${m.role}</td><td>${m.status}</td><td><c:choose><c:when test="${m.loginId == currentLoginId}"><span class="admin-status"><fmt:message key="admin.currentAccount"/></span></c:when><c:otherwise><form class="admin-inline-form" action="<c:url value='/admin/members/${m.id}/role'/>" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><select name="role"><option value="MEMBER" ${m.role=='MEMBER'?'selected':''}>MEMBER</option><option value="ADMIN" ${m.role=='ADMIN'?'selected':''}>ADMIN</option></select><input name="reason" maxlength="1000" placeholder="<fmt:message key='admin.statusReason'/>"><button class="button" type="submit"><fmt:message key="admin.saveRole"/></button></form><form class="admin-inline-form" action="<c:url value='/admin/members/${m.id}/status'/>" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="status" value="${m.status=='ACTIVE'?'INACTIVE':'ACTIVE'}"><input name="reason" maxlength="1000" placeholder="<fmt:message key='admin.statusReason'/>"><button class="button" type="submit"><c:choose><c:when test="${m.status=='ACTIVE'}"><fmt:message key="admin.disable"/></c:when><c:otherwise><fmt:message key="admin.enable"/></c:otherwise></c:choose></button></form></c:otherwise></c:choose></td></tr></c:forEach>
</tbody></table></div></section><section class="content-panel"><h2><fmt:message key="admin.auditHistory"/></h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th><fmt:message key="admin.member"/></th><th><fmt:message key="admin.admin"/></th><th><fmt:message key="admin.status"/></th><th><fmt:message key="admin.reason"/></th></tr></thead><tbody><c:forEach items="${audits}" var="a"><tr><td>${a.id}</td><td><c:out value="${a.member_login_id}"/></td><td><c:out value="${a.admin_login_id}"/></td><td>${a.previous_status} → ${a.new_status}</td><td><c:out value="${a.reason}"/></td></tr></c:forEach></tbody></table></div></section></section></main><%@ include file="../fragments/footer.jspf" %></body></html>

