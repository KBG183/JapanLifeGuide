<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/><c:set var="adminSection" value="sources"/><!DOCTYPE html><html lang="${currentLanguage}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><fmt:message key="admin.sources"/> | JAPAN LIFE GUIDE</title><c:url var="css" value="/css/app.css"/><link rel="stylesheet" href="${css}"></head><body><%@ include file="../fragments/header.jspf" %><main id="main" class="admin-layout"><%@ include file="admin-nav.jspf" %><section class="admin-main"><header class="admin-page-header"><div><p class="eyebrow"><fmt:message key="admin.contentGroup"/></p><h1><fmt:message key="admin.sources"/></h1></div></header><section class="content-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th><fmt:message key="admin.procedureId"/></th><th><fmt:message key="admin.titleLabel"/></th><th><fmt:message key="admin.url"/></th><th><fmt:message key="admin.checkedOn"/></th></tr></thead><tbody><c:forEach items="${sources}" var="s"><tr><td>${s.id}</td><td>${s.procedure_id}</td><td><c:out value="${s.title}"/></td><td><a href="<c:out value='${s.url}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${s.url}"/></a></td><td>${s.checked_on}</td></tr></c:forEach></tbody></table></div></section></section></main><%@ include file="../fragments/footer.jspf" %></body></html>

