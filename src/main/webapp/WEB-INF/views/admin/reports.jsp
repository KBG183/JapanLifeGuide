<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/>
<c:set var="adminSection" value="reports"/>
<!DOCTYPE html>
<html lang="${currentLanguage}">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><fmt:message key="community.reports"/> | JAPAN LIFE GUIDE</title><c:url var="css" value="/css/app.css"/><link rel="stylesheet" href="${css}"></head>
<body>
<%@ include file="../fragments/header.jspf" %>
<main id="main" class="admin-layout">
  <%@ include file="admin-nav.jspf" %>
  <section class="admin-main"><header class="admin-page-header"><div><p class="eyebrow"><fmt:message key="admin.communityGroup"/></p><h1><fmt:message key="community.reports"/></h1></div></header><c:if test="${param.updated ne null}"><p class="form-success admin-report-notice" role="status"><fmt:message key="admin.reportUpdated"/></p></c:if><section class="content-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th><fmt:message key="community.reportTarget"/></th><th><fmt:message key="community.reporter"/></th><th><fmt:message key="community.reason"/></th><th><fmt:message key="admin.status"/></th><th><fmt:message key="admin.actions"/></th></tr></thead><tbody><c:forEach items="${reports}" var="r"><tr><td>${r.id}</td><td class="admin-report-target"><c:choose><c:when test="${not empty r.comment_id}"><p><strong><fmt:message key="admin.reportComment"/>:</strong> <c:choose><c:when test="${not empty r.comment_body}"><c:out value="${r.comment_body}"/></c:when><c:otherwise><fmt:message key="community.deletedContent"/></c:otherwise></c:choose></p><small><strong><fmt:message key="admin.author"/>:</strong> <c:out value="${r.comment_author_display_name}"/> <span>@<c:out value="${r.comment_author_login_id}"/></span></small></c:when><c:otherwise><p><strong><fmt:message key="admin.reportPost"/>:</strong> <c:choose><c:when test="${not empty r.post_title}"><c:out value="${r.post_title}"/></c:when><c:otherwise><fmt:message key="community.deletedContent"/></c:otherwise></c:choose></p><small><strong><fmt:message key="admin.author"/>:</strong> <c:out value="${r.post_author_display_name}"/> <span>@<c:out value="${r.post_author_login_id}"/></span></small></c:otherwise></c:choose><c:if test="${not empty r.target_post_id}"><a class="admin-report-link" href="<c:url value='/community/${r.target_post_id}'/>"><fmt:message key="admin.openPublicPage"/></a></c:if></td><td><c:out value="${r.reporter_display_name}"/> <small>@<c:out value="${r.reporter_login_id}"/></small></td><td><c:out value="${r.reason}"/></td><td><span class="admin-status ${r.status == 'OPEN' ? '' : 'hidden'}">${r.status}</span><c:if test="${not empty r.last_action}"><small class="admin-report-history"><c:out value="${r.last_action}"/> · @<c:out value="${r.last_admin_login_id}"/> · <fmt:formatDate value="${r.last_action_at}" pattern="yyyy.MM.dd HH:mm"/></small></c:if></td><td><c:if test="${r.status == 'OPEN'}"><div class="admin-report-actions"><form method="post" action="<c:url value='/admin/reports/${r.id}/moderate'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="action" value="REJECT"><button class="button secondary" type="submit"><fmt:message key="admin.rejectReport"/></button></form><form method="post" action="<c:url value='/admin/reports/${r.id}/moderate'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="action" value="HIDE"><button class="button warning" type="submit" onclick="return confirm('<fmt:message key="admin.reportHideConfirm"/>')"><fmt:message key="admin.hideReportTarget"/></button></form><form method="post" action="<c:url value='/admin/reports/${r.id}/moderate'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="action" value="DELETE"><button class="button danger" type="submit" onclick="return confirm('<fmt:message key="admin.reportDeleteConfirm"/>')"><fmt:message key="admin.deleteReportTarget"/></button></form></div></c:if></td></tr></c:forEach></tbody></table></div><c:if test="${empty reports}"><p class="admin-empty"><fmt:message key="admin.noReports"/></p></c:if></section></section>
</main>
<%@ include file="../fragments/footer.jspf" %>
</body>
</html>
