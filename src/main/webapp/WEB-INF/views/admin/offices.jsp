<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/><c:set var="adminSection" value="offices"/><!DOCTYPE html><html lang="${currentLanguage}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><fmt:message key="admin.offices"/> | JAPAN LIFE GUIDE</title><c:url var="css" value="/css/app.css"/><link rel="stylesheet" href="${css}"></head><body><%@ include file="../fragments/header.jspf" %><main id="main" class="admin-layout"><%@ include file="admin-nav.jspf" %><section class="admin-main"><header class="admin-page-header"><div><p class="eyebrow"><fmt:message key="admin.contentGroup"/></p><h1><fmt:message key="admin.offices"/></h1></div></header><section class="content-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th><fmt:message key="admin.offices"/></th><th><fmt:message key="admin.address"/></th><th><fmt:message key="admin.homepage"/></th><th><fmt:message key="admin.note"/></th></tr></thead><tbody><c:forEach items="${offices}" var="o"><tr><td>${o.id}</td><td><c:out value="${o.name}"/></td><td><c:out value="${o.address}"/></td><td><a href="<c:out value='${o.homepage_url}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${o.homepage_url}"/></a></td><td><c:out value="${o.note}"/></td></tr></c:forEach></tbody></table></div></section></section></main><%@ include file="../fragments/footer.jspf" %></body></html>

