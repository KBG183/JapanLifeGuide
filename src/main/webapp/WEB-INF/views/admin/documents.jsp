<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/><c:set var="adminSection" value="documents"/><!DOCTYPE html><html lang="${currentLanguage}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><fmt:message key="admin.documents"/> | JAPAN LIFE GUIDE</title><c:url var="css" value="/css/app.css"/><link rel="stylesheet" href="${css}"></head><body><%@ include file="../fragments/header.jspf" %><main id="main" class="admin-layout"><%@ include file="admin-nav.jspf" %><section class="admin-main"><header class="admin-page-header"><div><p class="eyebrow"><fmt:message key="admin.contentGroup"/></p><h1><fmt:message key="admin.documents"/></h1></div></header><section class="content-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th><fmt:message key="admin.procedureId"/></th><th><fmt:message key="admin.titleLabel"/></th><th><fmt:message key="admin.requirement"/></th><th><fmt:message key="admin.displayOrder"/></th><th><fmt:message key="admin.translations"/></th><th><fmt:message key="admin.actions"/></th></tr></thead><tbody><c:forEach items="${documents}" var="d"><tr><td>${d.id}</td><td>${d.procedure_id}</td><td><c:out value="${d.name}"/></td><td>${d.requirement}</td><td>${d.display_order}</td><td><c:choose><c:when test="${d.has_ko > 0}"><span class="lang-badge lang-badge-yes">KO</span></c:when><c:otherwise><span class="lang-badge lang-badge-no">KO</span></c:otherwise></c:choose><c:choose><c:when test="${d.has_en > 0}"><span class="lang-badge lang-badge-yes">EN</span></c:when><c:otherwise><span class="lang-badge lang-badge-no">EN</span></c:otherwise></c:choose></td><td><a href="<c:url value='/admin/documents/${d.id}/translations'/>" class="button-outline"><fmt:message key="admin.translations"/></a></td></tr></c:forEach></tbody></table></div></section></section></main><%@ include file="../fragments/footer.jspf" %></body></html>

