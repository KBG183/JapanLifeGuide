<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/>
<footer class="site-footer"><div><strong>JAPAN LIFE GUIDE</strong><p><fmt:message key="footer.tagline"/></p><p class="footer-links"><a href="<c:url value='/privacy'/>"><fmt:message key="footer.privacy"/></a> · <a href="<c:url value='/terms'/>"><fmt:message key="footer.terms"/></a> · <a href="<c:url value='/community/rules'/>"><fmt:message key="footer.communityRules"/></a></p></div><p><fmt:message key="footer.disclaimer"/><br><fmt:message key="footer.checkOfficial"/></p></footer>
<script src="${scriptUrl}" defer></script>
