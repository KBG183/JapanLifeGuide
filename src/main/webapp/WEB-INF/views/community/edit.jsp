<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/><!DOCTYPE html><html lang="${currentLanguage}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><fmt:message key="community.editPost"/> | JAPAN LIFE GUIDE</title><c:url var="css" value="/css/app.css"/><link rel="stylesheet" href="${css}"></head><body><%@ include file="../fragments/header.jspf" %><main id="main" class="community-shell"><section class="content-panel"><h1><fmt:message key="community.editPost"/></h1><form class="community-write-form" method="post" action="<c:url value='/community/${post.id}/edit'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label><fmt:message key="community.category"/><select name="category"><c:forEach items="${['GENERAL','ADMIN','HOME','STUDENT','WORK','MEETUP']}" var="category"><option value="${category}" ${post.category == category ? 'selected' : ''}><fmt:message key="community.category.${category}"/></option></c:forEach></select></label><label><fmt:message key="community.subject"/><input name="title" maxlength="200" value="<c:out value='${post.title}'/>" required></label><label><fmt:message key="community.body"/><textarea name="body" maxlength="10000" required><c:out value="${post.body}"/></textarea></label><button class="button" type="submit"><fmt:message key="community.saveEdit"/></button></form></section></main><%@ include file="../fragments/footer.jspf" %></body></html>
