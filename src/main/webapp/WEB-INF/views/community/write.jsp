<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="${currentLanguage}"/><fmt:setBundle basename="messages/messages"/><!DOCTYPE html><html lang="${currentLanguage}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><fmt:message key="community.write"/> | JAPAN LIFE GUIDE</title><c:url var="css" value="/css/app.css"/><link rel="stylesheet" href="${css}"></head><body><%@ include file="../fragments/header.jspf" %><main id="main" class="community-shell"><section class="content-panel"><h1><fmt:message key="community.write"/></h1><form class="community-write-form" method="post" enctype="multipart/form-data" action="<c:url value='/community/write'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label><fmt:message key="community.category"/><select name="category"><option value="GENERAL"><fmt:message key="community.category.GENERAL"/></option><option value="ADMIN"><fmt:message key="community.category.ADMIN"/></option><option value="HOME"><fmt:message key="community.category.HOME"/></option><option value="STUDENT"><fmt:message key="community.category.STUDENT"/></option><option value="WORK"><fmt:message key="community.category.WORK"/></option><option value="MEETUP"><fmt:message key="community.category.MEETUP"/></option></select></label><label><fmt:message key="community.subject"/><input name="title" maxlength="200" required></label><label><fmt:message key="community.body"/><textarea name="body" maxlength="10000" required></textarea></label><label><fmt:message key="community.images"/><input type="file" name="images" accept="image/jpeg,image/png,image/gif,image/webp" multiple></label><button class="button" type="submit"><fmt:message key="community.submit"/></button></form></section></main><%@ include file="../fragments/footer.jspf" %></body></html>
